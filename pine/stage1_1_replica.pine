//@version=6
// =============================================================================
// Stage 1.1 Replica — mekanika backtest yang dipakai, bukan strategi yang lolos
// =============================================================================
// PENTING, BACA DULU:
// Stage 1.1 menguji 9 faktor dan NOL yang lolos kriteria KEEP. Script ini bukan
// strategi yang direkomendasikan. Ini replika MEKANIKA-nya supaya Anda bisa
// melihat sendiri di chart apa yang sebenarnya diuji:
//   - notional $6.00 fixed (margin 3% x leverage 2x) dengan pembulatan stepSize
//   - sinyal dibaca di bar yang CLOSED tepat jam entry, order isi di open bar entry
//   - hold persis 48 jam, keluar di open
//   - fee taker 0.05% + slippage 0.05% per sisi (= 0.20% round trip)
//   - filter trigger EMA9 / EMA21 (run R8)
//
// TIMEFRAME:
//   1 JAM  = replika persis Stage 1.1 (data aslinya bar 1H).
//   Intraday lain tetap jalan, tapi EMA9/EMA21 berubah arti.
//   1 HARI  tetap jalan (hold 48h = 2 bar) tapi entry jadi tiap hari tanpa
//           penyaringan jam dan EMA-nya EMA harian - BUKAN replika Stage 1.1.
//   Pakai symbol PERP (mis. BINANCE:SHIBUSDT.P), bukan spot.
//
// YANG TIDAK BISA DIREPLIKA DI PINE — dan ini justru faktor utamanya:
//   1. funding_xs_pct (R1, R6, R7) butuh MERANKING ~470 coin pada hari yang sama.
//      Pine hanya melihat satu symbol. Tidak ada jalan keluar di Pine.
//   2. Funding rate Binance tidak tersedia sebagai deret data di TradingView,
//      jadi biaya funding aktual tidak bisa dihitung. Disediakan input manual.
//   3. Versi market-neutral (kurangi mean cross-section harian) butuh seluruh
//      universe. Tidak mungkin di Pine.
//   4. Standard error di-cluster per tanggal — itu statistik, bukan chart.
// Artinya: backtest di sini = R0 (baseline) + R8 (trigger EMA) saja.
// Hasil Stage 1.1 untuk keduanya: expectancy negatif.
//
// stepSize per symbol ada di results/gate_per_symbol.csv (kolom step_size_mode).
// Contoh: BTCUSDT 0.001, ETHUSDT 0.001, XRPUSDT 0.1, DOGEUSDT 1, 1000PEPEUSDT 1
// =============================================================================

strategy("Stage 1.1 Replica - $6 notional / 48h hold",
     overlay              = true,
     initial_capital      = 100,
     currency             = currency.USD,
     default_qty_type     = strategy.fixed,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.10,
     pyramiding           = 0,
     calc_on_every_tick   = false,
     process_orders_on_close = false)

// ------------------------------------------------------------------ input
grpS = "Sizing (LOCKED di Stage 1.1)"
notional = input.float(6.00, "Notional per trade (USD)", minval=0.1, group=grpS, tooltip="margin 3% x $100 x leverage 2x = $6.00 fixed. Tidak diturunkan dari stop/ATR.")
stepSize = input.float(1.0, "stepSize (LOT_SIZE) symbol ini", minval=0.00000001, group=grpS, tooltip="Ambil dari results/gate_per_symbol.csv kolom step_size_mode. Salah isi = panel executable bohong.")
quantTol = input.float(10.0, "Toleransi error kuantisasi (%)", minval=0, maxval=100, group=grpS)
skipIfNotExecutable = input.bool(true, "Lewati trade kalau tidak executable di $6", group=grpS)

grpT = "Timing"
holdHours = input.int(48, "Hold (jam)", minval=1, maxval=168, group=grpT, tooltip="Label utama Stage 1.1 = 48 jam. 24 dan 72 juga diuji.")
entryHourUTC = input.int(0, "Jam entry (UTC)", minval=0, maxval=23, group=grpT, tooltip="Diabaikan di chart harian.")

grpD = "Arah & filter (run R8)"
dirMode = input.string("Long", "Arah", options=["Long", "Short"], group=grpD)
emaMode = input.string("Tanpa trigger", "Trigger EMA", options=["Tanpa trigger", "EMA9 searah", "EMA21 searah"], group=grpD, tooltip="R8: EMA9 menambah +0.023% (t=0.08), EMA21 -0.209% (t=-0.74). Keduanya nol.")

grpC = "Biaya"
fundingPerPeriod = input.float(0.0, "Perkiraan funding per periode (%)", step=0.001, group=grpC, tooltip="TIDAK tersedia di TradingView. Isi manual kalau mau memperkirakan. Di data asli median funding 48h = +0.049%, rentang -61.7% s/d +15.4%.")
fundingHours = input.int(8, "Interval funding (jam)", options=[4, 8], group=grpC, tooltip="Di universe Binance: 474 symbol pakai 4 jam, 261 symbol pakai 8 jam.")

// ------------------------------------------------------------------ timeframe
secPerBar = timeframe.in_seconds()
holdBars  = math.max(1, math.round(holdHours * 3600.0 / secPerBar))
tfOK      = timeframe.isminutes or timeframe.isdaily
isExact   = timeframe.isminutes and timeframe.multiplier == 60

// Bar sinyal = bar yang CLOSED tepat pada jam entry. Order strategy.entry terisi
// di OPEN bar berikutnya, yaitu bar entry itu sendiri. Ini yang menyamakan Pine
// dengan src/features.py: fitur dari bar closed di d 00:00, entry di open d 00:00.
nextStart   = time + secPerBar * 1000
isSignalBar = timeframe.isdaily ? true : (hour(nextStart, "UTC") == entryHourUTC and minute(nextStart, "UTC") == 0)

// ------------------------------------------------------------------ eksekutabilitas (§2.5)
// Memakai close bar sinyal = harga di instan keputusan (close_t di panel Python).
qtyIdeal     = notional / close
qtyActual    = math.floor(qtyIdeal / stepSize) * stepSize
notionalReal = qtyActual * close
quantErr     = math.abs(notionalReal - notional) / notional * 100.0
executable   = qtyActual >= stepSize and quantErr <= quantTol

// ------------------------------------------------------------------ fitur EMA (§3.1)
// Dibaca di bar sinyal itu sendiri (bar yang sudah closed), bukan [1].
ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
state9  = close > ema9  and ema9  > ema9[1]  ? 1 : close < ema9  and ema9  < ema9[1]  ? -1 : 0
state21 = close > ema21 and ema21 > ema21[1] ? 1 : close < ema21 and ema21 < ema21[1] ? -1 : 0

isLong    = dirMode == "Long"
wantDir   = isLong ? 1 : -1
useEma9   = emaMode == "EMA9 searah"
useEma21  = emaMode == "EMA21 searah"
triggerOK = useEma9 ? state9 == wantDir : useEma21 ? state21 == wantDir : true

// ------------------------------------------------------------------ sinyal
execOK   = executable or not skipIfNotExecutable
flat     = strategy.position_size == 0
canEnter = tfOK and isSignalBar and triggerOK and execOK and flat and qtyActual > 0

if canEnter
    if isLong
        strategy.entry("L", strategy.long, qty=qtyActual)
    else
        strategy.entry("S", strategy.short, qty=qtyActual)

// Exit diperintahkan 1 bar lebih awal supaya TERISI di open bar ke-holdBars.
barsHeld = strategy.position_size != 0 ? bar_index - strategy.opentrades.entry_bar_index(0) : 0
if strategy.position_size != 0 and barsHeld >= holdBars - 1
    strategy.close_all(comment="hold " + str.tostring(holdHours) + "h")

// ------------------------------------------------------------------ funding (catatan terpisah)
// Pine tidak bisa memotong arus kas periodik dari equity strategy, jadi ini
// dihitung sebagai catatan, BUKAN dikurangkan dari hasil backtester.
var float fundingDrag = 0.0
float nPeriods = holdHours * 1.0 / fundingHours
if canEnter
    fundingDrag := fundingDrag + (fundingPerPeriod / 100.0) * nPeriods * notionalReal * (isLong ? 1 : -1)

// ------------------------------------------------------------------ diagnosa
var int nSignalBars  = 0
var int nBlockedExec = 0
if isSignalBar
    nSignalBars += 1
    if not execOK
        nBlockedExec += 1

reason = not tfOK ? "TIMEFRAME tidak didukung" : nSignalBars == 0 ? "Tidak ada bar sinyal - cek jam entry / timeframe" : strategy.closedtrades == 0 and nBlockedExec >= nSignalBars ? "Semua kandidat gagal gate $6 - cek stepSize" : strategy.closedtrades == 0 ? "Trigger EMA menyaring habis" : "OK"

// ------------------------------------------------------------------ panel
var table t = table.new(position.top_right, 2, 12, border_width=1)
if barstate.islast
    netAfterFunding = strategy.netprofit - fundingDrag
    okCol  = color.new(color.green, 80)
    badCol = color.new(color.red, 80)
    table.cell(t, 0, 0, "Stage 1.1 Replica", text_size=size.small, bgcolor=color.new(color.blue, 80))
    table.cell(t, 1, 0, dirMode + " / " + str.tostring(holdHours) + "h", text_size=size.small, bgcolor=color.new(color.blue, 80))
    table.cell(t, 0, 1, "status", text_size=size.tiny)
    table.cell(t, 1, 1, reason, text_size=size.tiny, bgcolor=reason == "OK" ? okCol : badCol)
    table.cell(t, 0, 2, "timeframe chart", text_size=size.tiny)
    table.cell(t, 1, 2, timeframe.period + (isExact ? " (replika persis)" : " (bukan 1H)"), text_size=size.tiny, bgcolor=isExact ? okCol : color.new(color.orange, 80))
    table.cell(t, 0, 3, "hold = berapa bar", text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(holdBars), text_size=size.tiny)
    table.cell(t, 0, 4, "bar sinyal ditemukan", text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(nSignalBars), text_size=size.tiny, bgcolor=nSignalBars > 0 ? okCol : badCol)
    table.cell(t, 0, 5, "qty ideal", text_size=size.tiny)
    table.cell(t, 1, 5, str.tostring(qtyIdeal, "#.########"), text_size=size.tiny)
    table.cell(t, 0, 6, "qty setelah stepSize", text_size=size.tiny)
    table.cell(t, 1, 6, str.tostring(qtyActual, "#.########"), text_size=size.tiny)
    table.cell(t, 0, 7, "notional aktual", text_size=size.tiny)
    table.cell(t, 1, 7, "$" + str.tostring(notionalReal, "#.####"), text_size=size.tiny)
    table.cell(t, 0, 8, "error kuantisasi", text_size=size.tiny)
    table.cell(t, 1, 8, str.tostring(quantErr, "#.##") + "%", text_size=size.tiny, bgcolor=quantErr <= quantTol ? okCol : badCol)
    table.cell(t, 0, 9, "executable @ $6", text_size=size.tiny)
    table.cell(t, 1, 9, executable ? "YA" : "TIDAK", text_size=size.tiny, bgcolor=executable ? okCol : badCol)
    table.cell(t, 0, 10, "jumlah trade", text_size=size.tiny)
    table.cell(t, 1, 10, str.tostring(strategy.closedtrades), text_size=size.tiny)
    table.cell(t, 0, 11, "net setelah perkiraan funding", text_size=size.tiny)
    table.cell(t, 1, 11, "$" + str.tostring(netAfterFunding, "#.##"), text_size=size.tiny, bgcolor=netAfterFunding >= 0 ? okCol : badCol)

plot(ema9,  "EMA9",  color=color.new(color.orange, 0), linewidth=1)
plot(ema21, "EMA21", color=color.new(color.blue, 0),   linewidth=1)
bgcolor(canEnter ? color.new(color.green, 92) : na)
